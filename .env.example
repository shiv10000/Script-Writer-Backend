# Copy this file to .env and replace every placeholder with a local value.
# Generate JWT_SECRET with: openssl rand -base64 32

DB_URL=jdbc:postgresql://localhost:5432/company_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password
JWT_SECRET=replace_with_a_base64_encoded_32_byte_secret

# Optional settings
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_MS=604800000
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Redis connection used for email-verification codes.
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth 2.0 / OpenID Connect client credentials.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
